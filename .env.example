# PostHog (personal API key with project read access — NOT the client SDK key)
POSTHOG_API_KEY=
POSTHOG_HOST=https://n.gostylens.com
POSTHOG_PROJECT_ID=

# Notion Experiments database (GoStylens teamspace → GoStylens → Experiments)
NOTION_EXPERIMENTS_DATABASE_ID=3cf3d958-f999-8087-b60c-cea1e848d2ad

# Meta Marketing API (Ads Insights — read your own ad account)
# Token: Graph API Explorer or System User; needs ads_read
# Ad account ID: from Ads Manager URL (act_123…) — with or without act_ prefix
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_GRAPH_VERSION=v22.0

# App Store Connect API (Analytics Reports — product page views / engagement)
# Create key: App Store Connect → Users and Access → Integrations → App Store Connect API
# Role needs access to App Analytics. Keep the .p8 outside git (path only in .env).
# APPLE_ASC_ISSUER_ID=
# APPLE_ASC_KEY_ID=
# APPLE_ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXX.p8
# APPLE_ASC_BUNDLE_ID=com.stylenslab.gostylens
# APPLE_ASC_APP_ID=   # optional numeric Apple ID from --list-apps

# Optional: RevenueCat, Slack, Linear, etc. as you add integrations
# REVENUECAT_API_KEY=
# SLACK_WEBHOOK_URL=
